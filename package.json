{
  "name": "dsh-desktop-app",
  "version": "2.0.0",
  "private": true,
  "author": "aokamoaki",
  "license": "MIT",
  "description": "Lightweight DeepSeek Harness desktop shell - native window + tray wrapping an already-installed dsh web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aokamoaki/dsh-desktop-app.git"
  },
  "bugs": {
    "url": "https://github.com/aokamoaki/dsh-desktop-app/issues"
  },
  "homepage": "https://github.com/aokamoaki/dsh-desktop-app#readme",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test --test-isolation=none test/core.test.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "asar": true,
    "npmRebuild": false,
    "appId": "com.dsh.desktop",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "assets/**",
      "ui/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness",
      "artifactName": "DeepSeek-Harness-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Portable-${version}.${ext}"
    }
  }
}